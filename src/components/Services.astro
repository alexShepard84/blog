---
import SectionTitle from './SectionTitle.astro'
import AutomationIntro from './AutomationIntro.astro'
import { services } from '../data/site.ts'

const serviceGroups = [services.slice(0, 2), services.slice(2)]
---

<section id="leistungen" class="bg-white">
  <div class="mx-auto flex max-w-300 flex-col gap-10 px-5 pt-24 sm:px-8">
    <SectionTitle>Leistungen</SectionTitle>
    {serviceGroups.map((group, index) => (
      <>
        {index === 1 && <AutomationIntro />}
        <ol start={index * 2 + 1} class="m-0 list-none border-b border-line p-0">
          {group.map((service) => (
            <li class="flex flex-wrap gap-x-10 gap-y-4 border-t border-line py-8">
              <span class="w-14 pt-1.5 font-mono text-sm text-muted">{service.number}</span>
              <h3 class="m-0 min-w-0 flex-[1_1_300px] text-[26px] font-bold leading-tight tracking-[-0.01em]">{service.title}</h3>
              <div class="flex min-w-0 flex-[1_1_420px] flex-col gap-4">
                <p class="m-0 text-lg leading-relaxed text-graphite-soft">{service.summary}</p>
                <ul class="m-0 flex list-none flex-col gap-2 p-0 text-base text-graphite-soft">
                  {service.points.map((point) => (
                    <li class="flex items-baseline gap-3">
                      <span aria-hidden="true" class="size-[7px] shrink-0 bg-mint-dark" />
                      {point}
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ))}
        </ol>
      </>
    ))}
  </div>
</section>
