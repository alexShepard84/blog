---
import LogoMark from './LogoMark.astro'
import { navigation, site } from '../data/site.ts'
import { bookingHref, isExternal } from '../lib/contact.ts'

const cta = bookingHref(site.calUrl, site.email)
const ctaAttrs = isExternal(cta) ? { target: '_blank', rel: 'noopener' } : {}
---

<header class="bg-graphite text-paper">
  <div class="mx-auto flex max-w-300 items-center gap-8 px-5 py-5 sm:px-8">
    <a href="/" aria-label="AppConcept – zur Startseite" class="flex items-center gap-2.5">
      <LogoMark variant="light" />
      <span class="text-[21px] tracking-[-0.01em]"><span class="font-bold">App</span>Concept</span>
    </a>
    <nav aria-label="Hauptnavigation" class="hidden grow justify-end gap-8 text-base md:flex">
      {navigation.map((item) => <a href={item.href} class="hover:text-mint hover:underline">{item.label}</a>)}
    </nav>
    <a
      href={cta}
      {...ctaAttrs}
      class="hidden rounded border-[1.5px] border-paper px-5 py-3 text-[15px] font-semibold text-paper hover:bg-paper hover:text-graphite md:inline-flex"
      >Erstgespräch vereinbaren</a
    >
    <details class="relative ml-auto md:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded border border-graphite-line px-3 text-[15px] text-paper"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        Menü
      </summary>
      <nav
        aria-label="Mobile Navigation"
        class="absolute right-0 top-[calc(100%+8px)] z-20 flex w-64 flex-col border border-line bg-white p-2 text-base text-graphite"
      >
        {navigation.map((item) => <a href={item.href} class="flex min-h-11 items-center px-3 hover:bg-paper">{item.label}</a>)}
        <a
          href={cta}
          {...ctaAttrs}
          class="mt-2 flex min-h-11 items-center justify-center rounded bg-graphite px-3 text-[15px] font-semibold text-paper"
          >Erstgespräch vereinbaren</a
        >
      </nav>
    </details>
  </div>
</header>
