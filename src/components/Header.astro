---
import LogoMark from './LogoMark.astro'
import FirstContact from './FirstContact.astro'
import { navigation } from '../data/site.ts'
---

<header class="bg-graphite text-paper">
  <div class="mx-auto flex max-w-300 items-center gap-8 px-5 py-5 sm:px-8">
    <a href="/" aria-label="AppConcept – zur Startseite" class="flex items-center gap-2.5">
      <LogoMark variant="light" />
      <span class="text-[21px] tracking-[-0.01em]"><span class="font-bold">App</span>Concept</span>
    </a>
    <nav aria-label="Hauptnavigation" class="hidden grow justify-end gap-8 text-base lg:flex">
      {navigation.map((item) => <a href={item.href} class="hover:text-mint hover:underline">{item.label}</a>)}
    </nav>
    <div class="hidden lg:block"><FirstContact outline /></div>
    <details class="relative ml-auto lg:hidden">
      <summary
        class="flex min-h-11 cursor-pointer list-none items-center gap-2 rounded border border-graphite-line px-3 text-[15px] text-paper"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        Menü
      </summary>
      <nav
        aria-label="Mobile Navigation"
        class="absolute right-0 top-[calc(100%+8px)] z-20 flex w-72 flex-col border border-line bg-white p-2 text-base text-graphite"
      >
        {navigation.map((item) => <a href={item.href} class="flex min-h-11 items-center px-3 hover:bg-paper">{item.label}</a>)}
        <FirstContact class="mt-2" />
      </nav>
    </details>
  </div>
</header>
