---
import { Picture } from 'astro:assets'
import portrait from '../assets/portrait.jpg'
import FirstContact from './FirstContact.astro'
import { contact, hero, site } from '../data/site.ts'
import { bookingHref, isExternal } from '../lib/contact.ts'

const cta = bookingHref(site.calUrl, site.email)
const contactHint = isExternal(cta) ? contact.bookingHint : contact.mailHint
---

<section id="top" class="bg-graphite text-paper">
  <div
    class="mx-auto grid max-w-300 items-center gap-x-12 gap-y-10 px-5 pt-10 sm:px-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,0.85fr)] lg:pt-8"
  >
    <div class="flex min-w-0 flex-col gap-6 lg:pb-12">
      <p class="m-0 max-w-[36ch] text-lg font-medium text-graphite-ink">{hero.greeting}</p>
      <h1 class="stretch-display hyphens-manual m-0 text-[clamp(3rem,5.3vw,4.875rem)] font-extrabold leading-[1.02] tracking-[-0.035em] text-balance">
        {hero.headline}<span data-dot aria-hidden="true" class="ml-[0.04em] inline-block size-[0.17em] rounded-full bg-mint"></span>
      </h1>
      <p class="m-0 max-w-[52ch] text-lg leading-relaxed text-graphite-ink">{hero.intro}</p>
      <div class="flex flex-col gap-3">
        <div class="flex flex-wrap items-center gap-x-7 gap-y-3">
          <FirstContact />
          <a href="/#projekte" class="inline-flex min-h-11 items-center text-base underline underline-offset-[5px] hover:text-mint">{hero.secondaryCta}</a>
        </div>
        <p class="m-0 text-sm text-graphite-ink">{contactHint}</p>
      </div>
    </div>
    <div class="w-full max-w-[420px] justify-self-center self-end lg:justify-self-end">
      <Picture
        src={portrait}
        alt={hero.portraitAlt}
        formats={['avif', 'webp']}
        widths={[400, 600, 853]}
        sizes="(min-width: 1024px) 420px, (min-width: 480px) 420px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="block aspect-[5/6] w-full object-cover object-top"
      />
    </div>
  </div>
</section>
