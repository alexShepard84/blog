---
import { Picture } from 'astro:assets'
import portrait from '../assets/portrait.jpg'
import { hero, site } from '../data/site.ts'
import { bookingHref, isExternal } from '../lib/contact.ts'

const cta = bookingHref(site.calUrl, site.email)
const ctaAttrs = isExternal(cta) ? { target: '_blank', rel: 'noopener' } : {}
---

<section id="top" class="raster-bg border-b border-line bg-paper">
  <div
    class="mx-auto grid max-w-300 items-center gap-x-16 gap-y-14 px-5 pb-24 pt-14 sm:px-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,0.85fr)] lg:pt-20"
  >
    <div class="flex min-w-0 flex-col gap-8">
      <p class="m-0 flex max-w-full self-start overflow-hidden border border-line bg-white font-mono text-[13px] text-muted" aria-hidden="true">
        <span class="border-r border-line px-4 py-3 italic">fx</span>
        <span class="truncate px-4 py-3">{hero.formula}</span>
      </p>
      <p class="m-0 text-2xl font-medium text-graphite-soft">{hero.greeting}</p>
      <h1 class="stretch-display m-0 text-[clamp(2.625rem,5.4vw,4.875rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-balance">
        {hero.headline}{' '}
        <span class="relative inline-block border-[3px] border-mint-dark bg-white px-3 leading-[1.1]"
          >{hero.headlineMark}<span aria-hidden="true" class="absolute bottom-[-9px] right-[-9px] size-3 border-2 border-white bg-mint-dark"
          ></span></span
        >
      </h1>
      <p class="m-0 max-w-[560px] text-xl leading-[1.55] text-graphite-soft">{hero.intro}</p>
      <div class="flex flex-wrap items-center gap-6">
        <a href={cta} {...ctaAttrs} class="rounded bg-graphite px-6 py-4 font-semibold text-paper hover:bg-petrol">{hero.primaryCta}</a>
        <a href="/#projekte" class="font-mono text-sm underline underline-offset-4">{hero.secondaryCta} →</a>
      </div>
    </div>
    <figure class="m-0 w-full max-w-[480px] justify-self-center border border-line bg-white lg:justify-self-end">
      <Picture
        src={portrait}
        alt={hero.portraitAlt}
        formats={['avif', 'webp']}
        widths={[400, 600, 853]}
        sizes="(min-width: 1024px) 480px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="block aspect-[4/5] w-full object-cover object-top"
      />
      <figcaption class="flex justify-between gap-4 border-t border-line px-4 py-3 font-mono text-[13px] text-muted">
        <span>{site.owner}</span>
        <span>{site.address.locality}</span>
      </figcaption>
    </figure>
  </div>
</section>
