---
import { contact, site } from '../data/site.ts'
import FirstContact from './FirstContact.astro'
import { bookingHref, isExternal } from '../lib/contact.ts'

const cta = bookingHref(site.calUrl, site.email)
const external = isExternal(cta)
---

<section id="kontakt" class="bg-petrol text-paper">
  <div class="mx-auto flex max-w-300 flex-col gap-8 px-5 py-26 sm:px-8">
    <h2 class="stretch-display m-0 max-w-[900px] text-[clamp(2.25rem,5vw,4.25rem)] font-extrabold leading-[1.05] tracking-[-0.03em] text-balance">
      {contact.title}
    </h2>
    <p class="m-0 max-w-[680px] text-xl leading-relaxed text-petrol-ink">{contact.text}</p>
    {!external && <p class="m-0 max-w-[65ch] text-base leading-relaxed text-petrol-ink">{contact.prompt}</p>}
    <div class="flex flex-wrap items-center gap-7">
      <FirstContact />
      <a href={`mailto:${site.email}`} class="font-mono text-[15px] text-paper underline underline-offset-4 [overflow-wrap:anywhere]">{site.email}</a>
    </div>
    <p class="m-0 text-sm text-petrol-ink">{external ? contact.bookingHint : contact.mailHint}</p>
    <p class="m-0 font-mono text-[13px] text-petrol-ink">{contact.regionLine}</p>
  </div>
</section>
