---
import ProjectMedia from './ProjectMedia.astro'
import SectionTitle from './SectionTitle.astro'
import { clients, projects } from '../data/site.ts'
---

<section id="projekte" class="border-b border-line bg-white">
  <div class="mx-auto flex max-w-300 flex-col gap-22 px-5 py-28 sm:px-8">
    <SectionTitle>Projekte</SectionTitle>
    {
      projects.map((project, index) => (
        <article class="grid items-center gap-x-16 gap-y-10 lg:grid-cols-2" data-project={project.id}>
          <div class:list={['min-w-0', index % 2 === 1 && 'lg:order-last']}>
            <ProjectMedia project={project} />
          </div>
          <div class="flex min-w-0 flex-col gap-5">
            <p class:list={['m-0 font-mono text-[13px]', project.highlight ? 'text-mint-text' : 'text-muted']}>{project.label}</p>
            <h3 class="stretch-heading m-0 text-[clamp(2.25rem,4vw,3.5rem)] font-extrabold leading-none tracking-[-0.03em] text-balance">
              {project.title}
            </h3>
            <p class="m-0 text-[19px] leading-relaxed text-graphite-soft">{project.text}</p>
            <p class="m-0 font-mono text-[13px] text-muted">{project.meta.join(' · ')}</p>
            {project.url && (
              <a href={project.url} target="_blank" rel="noopener" class="self-start font-mono text-sm underline underline-offset-4">
                {new URL(project.url).host} ansehen ↗
              </a>
            )}
          </div>
        </article>
      ))
    }
    <p class="m-0 border-t border-line pt-7 text-[17px] leading-relaxed text-graphite-soft">{clients}</p>
  </div>
</section>
