---
import { contact, site } from '../data/site.ts'
import { bookingHref, isExternal } from '../lib/contact.ts'

interface Props {
  outline?: boolean
  class?: string
}

const { outline = false, class: className } = Astro.props
const href = bookingHref(site.calUrl, site.email)
const external = isExternal(href)
const label = external ? contact.ctaBooking : contact.ctaMail
---

<a
  href={href}
  {...(external ? { target: '_blank', rel: 'noopener' } : {})}
  aria-label={external ? label : `${label} – per E-Mail`}
  class:list={[
    'contact-cta inline-flex min-h-12 items-center justify-center gap-3 rounded px-5 py-3.5 text-base font-semibold',
    outline
      ? 'border border-paper text-paper hover:bg-paper hover:text-graphite'
      : 'bg-mint text-graphite hover:bg-paper',
    className,
  ]}
>
  {label}
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
    <path d="M4 12h15m-6-6 6 6-6 6" />
  </svg>
</a>
