---
import SectionTitle from './SectionTitle.astro'
import { faq } from '../data/site.ts'
---

<section id="faq" class="border-b border-line bg-white">
  <div
    class="mx-auto grid max-w-300 items-start gap-x-16 gap-y-10 px-5 py-26 sm:px-8 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)]"
  >
    <SectionTitle>Häufige Fragen</SectionTitle>
    <dl class="m-0 border-t border-line">
      {
        faq.map((item) => (
          <div class="flex flex-col gap-2 border-b border-line py-5.5">
            <dt class="text-[19px] font-bold">{item.question}</dt>
            <dd class="m-0 text-[17px] leading-relaxed text-graphite-soft">{item.answer}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
