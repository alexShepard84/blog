---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Seite nicht gefunden | AppConcept" description="Diese Seite gibt es nicht (mehr)." noindex>
  <section class="border-b border-line">
    <div class="mx-auto flex max-w-300 flex-col items-start gap-6 px-5 py-28 sm:px-8">
      <p class="m-0 border border-line bg-white px-4 py-3 font-mono text-sm text-muted">#BEZUG!</p>
      <h1 class="stretch-display m-0 text-[clamp(2.5rem,6vw,4.5rem)] font-extrabold leading-[1.05] tracking-[-0.03em]">
        Diese Seite gibt es nicht.
      </h1>
      <p class="m-0 max-w-[560px] text-xl leading-relaxed text-graphite-soft">
        Vielleicht ist sie umgezogen. Auf der Startseite finden Sie alles Wichtige.
      </p>
      <a href="/" class="rounded bg-graphite px-6 py-4 font-semibold text-paper hover:bg-petrol">Zur Startseite</a>
    </div>
  </section>
</BaseLayout>
