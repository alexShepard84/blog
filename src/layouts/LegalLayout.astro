---
import BaseLayout from './BaseLayout.astro'

interface Props {
  title: string
  description: string
  path: string
}

const { title, description, path } = Astro.props
---

<BaseLayout title={`${title} | AppConcept`} description={description} path={path}>
  <article
    class="mx-auto max-w-[760px] px-5 py-20 sm:px-8 [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mb-3 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-bold [&_p]:my-3 [&_p]:text-lg [&_p]:leading-relaxed [&_p]:text-graphite-soft [&_p]:[overflow-wrap:anywhere]"
  >
    <h1 class="stretch-display m-0 text-[clamp(2.25rem,5vw,3.5rem)] font-extrabold tracking-[-0.03em]">{title}</h1>
    <slot />
  </article>
</BaseLayout>
